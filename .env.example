# Copy this file to .env on the Raspberry Pi and tailor it to the installed hardware.

# USB camera device reported by `v4l2-ctl --list-devices` or `ls /dev/video*`.
CAMERA_DEVICE=/dev/video0
CAMERA_ID=pi-camera-01
MACHINE_ID=machine-01
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=5
YOLO_MODEL=/models/yolo11n.pt
YOLO_IMAGE_SIZE=320
YOLO_CONFIDENCE=0.50
PRESENCE_CONFIRM_FRAMES=2
ABSENCE_TIMEOUT_SECONDS=5
# The presence key expires after this period if the camera stops refreshing it.
PRESENCE_TTL_SECONDS=60
EVENT_STREAM_MAXLEN=10000
CAMERA_RECONNECT_SECONDS=5

# RFID/barcode scans establish an active user for this amount of time.
USER_SESSION_TTL_SECONDS=300

# Redis should normally stay local to the Pi. MQTT must be reachable by sensors.
REDIS_BIND_ADDRESS=127.0.0.1
MQTT_BIND_ADDRESS=0.0.0.0
